---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ImageModal from '../../components/ImageModal.astro';
import { getCollection } from 'astro:content';
import '../../styles/ArtworkDetail.css';
import '../../styles/ImageModal.css';

export async function getStaticPaths() {
  const artworks = await getCollection('advWalls');
  return artworks.map((artwork) => ({
    params: { id: artwork.data.id },
    props: { artwork: artwork.data },
  }));
}

const { artwork } = Astro.props;

const paragraphs = (artwork.description ?? '')
  .split('\n\n')
  .map((p) => p.trim())
  .filter(Boolean);

const metaSource =
  paragraphs[0] || artwork.altText || `${artwork.title} - Advertisement wall art by Mr Blob`;
const metaDescription =
  metaSource.length > 160
    ? `${metaSource.slice(0, 157).replace(/\s+\S*$/, '')}…`
    : metaSource;

const metaLine = [artwork.location, artwork.year].filter(Boolean).join(' — ');
---

<BaseLayout
  title={`${artwork.title} | Mr Blob Art`}
  description={metaDescription}
  ogTitle={`${artwork.title} - Mr Blob Art`}
  ogDescription={metaDescription}
  ogImage={artwork.imageUrl}
  ogUrl={`https://mrblobart.com/advWalls/${artwork.id}`}
>
  <div class="artwork-detail-page">
    <div class="artwork-detail-figure" data-modal-src={artwork.imageUrl}>
      <img src={artwork.imageUrl} alt={artwork.altText ?? artwork.title} />
    </div>
    <div class="artwork-detail-info">
      <h1 class="artwork-detail-title">{artwork.title}</h1>
      {metaLine && <p class="artwork-detail-meta-line">{metaLine}</p>}
      <div class="artwork-detail-meta">
        {artwork.festival && (
          <p><span class="meta-label">Festival:</span> {artwork.festival}</p>
        )}
        {artwork.project && (
          <p><span class="meta-label">Project:</span> {artwork.project}</p>
        )}
        {artwork.technique && (
          <p><span class="meta-label">Technique:</span> {artwork.technique}</p>
        )}
        {artwork.price && (
          <p><span class="meta-label">Price:</span> {artwork.price}</p>
        )}
        {artwork.contact && (
          <p><span class="meta-label">Contact:</span> <a href={`mailto:${artwork.contact}`}>{artwork.contact}</a></p>
        )}
      </div>
      {paragraphs.length > 0 && (
        <div class="artwork-detail-description">
          {paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      )}
    </div>
    <ImageModal />
  </div>
</BaseLayout>
