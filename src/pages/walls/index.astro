---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { getCollection } from 'astro:content';
import { artworkSrcset } from '../../utils/images';
import '../../styles/ArtworkList.css';

const artworks = (await getCollection('walls')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Walls Collection | Mr Blob Art"
  description="Explore Mr Blob's wall murals and street art from around the world."
  ogTitle="Walls Collection - Mr Blob Art"
  ogDescription="Explore Mr Blob's wall murals and street art from around the world."
  ogUrl="https://mrblobart.com/walls"
>
  <div class="artwork-list-page">
    <PageHero title="Walls Collection" />
    <div class="about-content-section">
      <div class="artwork-list-grid">
        {artworks.map((artwork) => (
          <a href={`/walls/${artwork.data.id}`} class="artwork-item">
            <div class="artwork-image-container">
              <img
                src={artwork.data.imageUrl}
                srcset={artworkSrcset(artwork.data.imageUrl)}
                sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw"
                alt={artwork.data.altText ?? artwork.data.title}
                loading="lazy"
              />
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
