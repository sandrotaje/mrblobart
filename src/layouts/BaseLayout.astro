---
interface Props {
  title?: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogUrl?: string;
}

const {
  title = 'Mr Blob Art | Urban Fine Artist & Commercial adWalls',
  description = 'Official site of Italian street artist Mr Blob. Contemporary fine art, sculptures, and adWalls: hand-painted advertising murals for brands',
  ogTitle = 'Mr Blob Art | Urban Fine Artist & Commercial adWalls',
  ogDescription = 'Official site of Italian street artist Mr Blob. Contemporary fine art, sculptures, and adWalls: hand-painted advertising murals for brands',
  ogImage = '/images/index.avif',
  ogUrl = 'https://mrblobart.com/',
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageAbsolute = new URL(ogImage, Astro.site);

// Privacy-friendly analytics: create an account on goatcounter.com,
// then set this to its code (e.g. 'mrblobart') to enable tracking.
const GOATCOUNTER_CODE = '';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '@fontsource/roboto/400.css';
import '@fontsource/roboto/700.css';
import '../styles/globals.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <meta name="author" content="Mr Blob Art" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={ogImageAbsolute} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={ogUrl} />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImageAbsolute} />

    <!-- Favicon -->
    <link rel="icon" type="image/avif" href="/images/favicon.avif" />
    <link rel="apple-touch-icon" href="/images/favicon.avif" />

    <!-- Preload critical resources -->
    <link rel="preload" href="/images/logo.avif" as="image" />

    <title>{title}</title>

    <slot name="head" />
  </head>
  <body>
    <div class="app">
      <Header />
      <main class="main-content">
        <slot />
      </main>
      <Footer />
    </div>
    {GOATCOUNTER_CODE && (
      <script
        is:inline
        async
        data-goatcounter={`https://${GOATCOUNTER_CODE}.goatcounter.com/count`}
        src="https://gc.zgo.at/count.js"></script>
    )}
  </body>
</html>
